{
  "name": "Tabi · Gestionar Viajes",
  "short_name": "Tabi",
  "description": "Organiza itinerarios, lugares, reservas y presupuesto en un solo lugar.",
  "start_url": "./",
  "id": "/",
  "scope": "/",
  "share_target": {
    "action": "/share",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "display": "standalone",
  "background_color": "#f7f6f2",
  "theme_color": "#e5484d",
  "shortcuts": [
    {
      "name": "Itinerario de hoy",
      "short_name": "Itinerario",
      "url": "/#itinerary",
      "icons": [{ "src": "/assets/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Abrir mapa",
      "short_name": "Mapa",
      "url": "/#map",
      "icons": [{ "src": "/assets/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Lista TODO",
      "short_name": "TODO",
      "url": "/#tasks",
      "icons": [{ "src": "/assets/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "icons": [
    { "src": "/assets/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "/assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" },
    { "src": "/assets/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any maskable" }
  ]
}
