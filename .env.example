# Puerto accesible únicamente desde localhost en Ubuntu Server.
TABI_HOST_PORT=4173

# Usa "latest" para actualizaciones automáticas con Watchtower.
# Para rollback, reemplázalo temporalmente por el SHA completo de un commit publicado.
TABI_IMAGE_TAG=latest

# Origen público exacto, sin barra final, utilizado para validar peticiones a través de Cloudflare.
TABI_PUBLIC_ORIGIN=https://tabi.example.com

# Debe permanecer en true cuando el acceso público sea HTTPS mediante Cloudflare.
TABI_SECURE_COOKIE=true
