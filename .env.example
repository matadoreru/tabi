# Puerto accesible únicamente desde localhost en Ubuntu Server.
TABI_HOST_PORT=4173

# Usa "latest" para actualizaciones automáticas con Watchtower.
# Para rollback, reemplázalo temporalmente por el SHA completo de un commit publicado.
TABI_IMAGE_TAG=latest

# Credenciales internas de PostgreSQL. Usa una contraseña aleatoria larga.
# Ejemplo para generarla: openssl rand -base64 32
TABI_POSTGRES_DB=tabi
TABI_POSTGRES_USER=tabi
TABI_POSTGRES_PASSWORD=CAMBIA_ESTA_CONTRASENA
TABI_POSTGRES_POOL_SIZE=10

# Origen público exacto, sin barra final, utilizado para validar peticiones a través de Cloudflare.
TABI_PUBLIC_ORIGIN=https://tabi.matadoreru.example.com

# Clave web restringida a este dominio y Map ID de Google Maps Platform.
TABI_GOOGLE_MAPS_API_KEY=MAPS KEY
# Clave de servidor con Places API (New), sin restricción por referente web.
TABI_GOOGLE_PLACES_API_KEY=PLACES SERVER KEY
TABI_GOOGLE_MAPS_MAP_ID=MAP ID

# Debe permanecer en true cuando el acceso público sea HTTPS mediante Cloudflare.
TABI_SECURE_COOKIE=true

# Opcional: habilita /api/metrics con Authorization: Bearer <token>
TABI_METRICS_TOKEN=

# Las actualizaciones automáticas quedan desactivadas por defecto; despliega tags/sha probados.
TABI_WATCHTOWER_ENABLE=false
